{
  "name": "tag-companion",
  "version": "0.1.3",
  "private": true,
  "description": "Extensão do Chrome que mostra o que os tags de fato enviaram: dataLayer, hits decodificados, consentimento, cookies e diagnósticos automáticos.",
  "license": "MIT",
  "author": "Rafael Ferreira",
  "repository": {
    "type": "git",
    "url": "https://github.com/RafaelFariaFerreira/tag-companion.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:ui": "vite --config preview/vite.config.ts",
    "release:zip": "pnpm build && mkdir -p release && rm -f release/tag-companion.zip && cd dist && zip -qr -X ../release/tag-companion.zip ."
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/chrome": "^0.0.324",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
