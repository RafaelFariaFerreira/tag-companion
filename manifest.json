{
  "manifest_version": 3,
  "name": "Tag Companion",
  "version": "0.1.5",
  "description": "Mostra o que os tags de fato enviaram: dataLayer, hits decodificados, consentimento, cookies e diagnósticos automáticos.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tag Companion — Abrir painel lateral",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "webRequest",
    "scripting",
    "cookies",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.google-analytics.com/*",
    "*://*.analytics.google.com/*",
    "*://*.googletagmanager.com/*",
    "*://*.googleadservices.com/*",
    "*://*.google.com/pagead/*",
    "*://*.doubleclick.net/*",
    "*://*.facebook.com/tr*",
    "*://*.connect.facebook.net/*",
    "*://*.ads.linkedin.com/*",
    "*://*.licdn.com/*",
    "*://*.hubspot.com/*",
    "*://*.hsforms.com/*",
    "*://*.hs-scripts.com/*",
    "*://*.hs-analytics.net/*",
    "*://*.hsforms.net/*",
    "*://*.clarity.ms/*",
    "*://*.tiktok.com/*",
    "*://*.reddit.com/*",
    "*://*.redditstatic.com/*",
    "*://*.twitter.com/*",
    "*://*.ads-twitter.com/*",
    "*://t.co/i/adsct*",
    "*://*.mixpanel.com/*",
    "*://*.mxpnl.com/*",
    "*://bzr.openai.com/*",
    "*://bzrcdn.openai.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
